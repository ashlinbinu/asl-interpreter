# Copy to backend/.env. Every setting is optional.

# On a host (docs/DEPLOYMENT.md, route B) set these in the host's environment settings instead of a .env file.

# Database. Default: SQLite at backend/asl.db. Any PostgreSQL URI works; migrations run at startup.
# Neon: Dashboard > Connect > connection string (keep ?sslmode=require). Supabase: Project Settings > Database > URI
# DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Processed data (landmark NPZ files, reference videos, recordings). Default: backend/data.
# Recommended: a folder OUTSIDE OneDrive on a drive with free space, e.g. D:\handspeak-data
# HANDSPEAK_STORE_DIR=D:\handspeak-data

# Where the API keeps landmarks, recordings and reference media: "local" (HANDSPEAK_STORE_DIR, the default) or "s3",
# an S3-compatible bucket such as Cloudflare R2, for hosts whose disk is wiped on every restart (Render's free plan).
# The bucket stays private; media is served through signed URLs. Needs boto3 (requirements-deploy.txt).
# The HANDSPEAK_S3_* values are also what `python -m scripts.publish_store --to-storage s3` uploads to.
# HANDSPEAK_STORAGE=s3
# HANDSPEAK_S3_BUCKET=signify-store
# HANDSPEAK_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# HANDSPEAK_S3_ACCESS_KEY_ID=
# HANDSPEAK_S3_SECRET_ACCESS_KEY=
# HANDSPEAK_S3_REGION=auto

# Trained models + MediaPipe .task files. Default: backend/models
# HANDSPEAK_MODELS_DIR=

# Raw image dataset used by the alphabet ingest script (optional convenience default).
# DATA_DIR=D:\datasets\asl_alphabet_train

# Allowed browser origins (comma separated, exact: scheme + host, no trailing slash, no path).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://YOUR-PROJECT.pages.dev

# Request size limits in bytes (JSON bodies / recorder uploads).
# HANDSPEAK_MAX_BODY_BYTES=8388608
# HANDSPEAK_MAX_UPLOAD_BYTES=62914560

# DEV ONLY: use the old procedurally generated templates as a fallback (never for real scoring).
# HANDSPEAK_DEV_SYNTHETIC=0
