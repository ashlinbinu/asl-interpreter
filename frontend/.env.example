# Copy to frontend/.env.production.local (or set these in Cloudflare Pages / Netlify). Read at BUILD time by Vite:
# change them, then rebuild.

# Where the API lives. Leave unset when the page and the API share an origin: `npm run dev` / `npm run preview`
# proxy /api and /media to the backend (docs/DEPLOYMENT.md, route A). Set it when they don't (route B): the backend's
# public URL followed by /api, no trailing slash. A full https:// URL also turns on the "waking up the server" screen.
# VITE_API_URL=https://YOUR-SERVICE.onrender.com/api
